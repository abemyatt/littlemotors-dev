
:root {
    --background: #FFF7E4;
    --surface: #FFFFFF;
    --primary: #3468CE;
    --primary-dark: #244EA1;
    --accent: #E65A4F;
    --highlight: #F5C84B;
    --text: #25365C;
    --text-muted: #455575;
    --border: #E7DFC9;

    --radius: 20px;
    --max-width: 1100px;
    --header-font: "Brush Script MT";
    --font: "Verdana";
}

* {
    box-sizing: border-box;
}

body {
    display: flex;
    flex-direction: column;
    min-height: 100vh;
    margin: 0;

    background: var(--background);
    color: var(--text);
    font-family: var(--font), sans-serif;
    font-size: 1.25rem;
    line-height: 1.6;
}

header {
    width: 100%;
    max-width: var(--max-width);
    margin: 24px auto 0;
    padding: 22px 32px 16px;

    background: var(--primary);
    border-radius: var(--radius);
    box-shadow: 0 6px 0 var(--primary-dark);
}

header h1 {
    margin: 0 0 8px;

    color: #FFFFFF;
    font-family: var(--header-font), cursive;
    font-size: 3.2rem;
}

nav ul {
    display: flex;
    justify-content: center;
    gap: 12px;

    margin: 0;
    padding: 0;
    list-style: none;
}

nav a {
    display: block;
    padding: 7px 24px;

    color: #FFFFFF;
    text-decoration: none;
    font-size: 1.4rem;
    font-weight: 700;
    border-radius: 999px;
}

nav a:hover {
    background: var(--highlight);
    color: var(--text);
}

nav a.active {
    background: var(--accent);
    color: #FFFFFF;
}

main {
    display: flex;
    flex-direction: column;
    flex: 1;
    gap: 24px;

    width: 100%;
    max-width: var(--max-width);
    margin: 36px auto;
}

.content {
    padding: 32px 40px;

    background: var(--surface);
    border: 2px solid var(--border);
    border-radius: var(--radius);
    box-shadow: 0 6px 0 rgba(37, 54, 92, 0.10);
}

.content h1 {
    margin: 0 0 18px;

    color: var(--primary-dark);
    font-size: 2.5rem;
}

.content h1::after {
    content: "";
    display: block;

    width: 64px;
    height: 6px;
    margin-top: 10px;

    background: var(--highlight);
    border-radius: 999px;
}

.content p {
    margin: 0 0 16px;
    color: var(--text-muted);
    font-size: 1.3rem;
}

.content p:last-child {
    margin-bottom: 0;
}

footer {
    padding: 24px 20px;

    border-top: 2px solid var(--border);
    color: var(--text-muted);
    text-align: center;
    font-size: 1.15rem;
}
